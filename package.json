{
  "name": "mouse-anatomy-atlas",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run verify:models",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "verify:models": "node scripts/verify-voxel-assets.mjs",
    "check": "tsc --noEmit && node scripts/check-observation.mjs && npm run verify:models",
    "build:pages": "npm run build -- --base=/mouse-anatomy-atlas/",
    "preview:pages": "vite preview --base=/mouse-anatomy-atlas/"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "description": "Interactive mouse anatomy atlas for exploring scan-derived surfaces and teaching models.",
  "license": "MIT"
}
